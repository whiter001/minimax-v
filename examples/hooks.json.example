{
  "hooks": [
    {
      "event": "PreToolUse",
      "matcher": "bash",
      "command": "grep -q 'rm -rf /' \"$MINIMAX_HOOK_INPUT\" && { echo 'dangerous command blocked by hook' >&2; exit 2; } || exit 0",
      "timeout": 10
    },
    {
      "event": "PostToolUse",
      "command": "cat \"$MINIMAX_HOOK_INPUT\" >> ~/.config/minimax/hook_audit.log",
      "timeout": 10
    },
    {
      "event": "SessionStart",
      "command": "echo \"[$(date)] session started\" >> ~/.config/minimax/hook_audit.log",
      "timeout": 10
    }
  ]
}
